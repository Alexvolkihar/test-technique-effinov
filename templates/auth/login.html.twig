{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg bg-dark text-white rounded-4 p-4">
                <h2 class="text-center fw-bold mb-4">Connexion</h2>
                <form action="{{ path('app_login') }}" method="post">
                    {% if error %}
                        <div class="alert alert-danger border-0 rounded-3 small p-2 mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}
                    <div class="mb-3">
                        <label class="form-label small">Adresse email</label>
                        <input type="email" name="_username" value="{{ last_username }}" class="form-control bg-secondary text-white border-0 py-2 rounded-3" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Mot de passe</label>
                        <input type="password" name="_password" class="form-control bg-secondary text-white border-0 py-2 rounded-3" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn w-100 py-2.5 text-white fw-bold rounded-3 border-0" style="background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);">
                        Se connecter
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Définir votre mot de passe{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg bg-dark text-white rounded-4 p-4">
                <h2 class="text-center fw-bold mb-3">Finaliser l'accès</h2>
                <p class="text-center text-secondary small mb-4">Veuillez définir votre mot de passe secret pour activer définitivement votre compte membre.</p>
                
                <form action="{{ path('app_password_setup') }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('password_setup') }}">
                    {% if error %}
                        <div class="alert alert-danger border-0 rounded-3 small p-2 mb-3">{{ error }}</div>
                    {% endif %}
                    
                    <div class="mb-3">
                        <label class="form-label small" for="password">Nouveau mot de passe (8 caractères minimum)</label>
                        <input type="password" id="password" name="password" class="form-control bg-secondary text-white border-0 py-2 rounded-3" required autofocus>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label small" for="confirm_password">Confirmer le mot de passe</label>
                        <input type="password" id="confirm_password" name="confirm_password" class="form-control bg-secondary text-white border-0 py-2 rounded-3" required>
                    </div>
                    
                    <button type="submit" class="btn w-100 py-2.5 text-white fw-bold rounded-3 border-0" style="background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);">
                        Activer mon compte
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

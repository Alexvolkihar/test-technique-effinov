{% extends 'base.html.twig' %}

{% block title %}Messages Secrets - FightClub{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <a href="{{ path('app_portal_home') }}" class="btn btn-sm btn-outline-secondary me-2">← Retour au portail</a>
                    <span class="badge bg-danger text-uppercase">Messagerie Chiffrée</span>
                </div>
                <div class="font-monospace text-secondary small">Session : {{ member.displayNumber }}</div>
            </div>

            <div class="row g-4">
                <!-- Messages List -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-lg bg-dark text-white rounded-4 p-4 d-flex flex-column" style="height: 500px;">
                        <h3 class="h5 fw-bold mb-3 border-bottom border-secondary pb-2">Fil de discussion</h3>
                        
                        <div class="flex-grow-1 overflow-y-auto mb-3 pe-2" style="max-height: 400px;">
                            {% if messages is empty %}
                                <div class="h-100 d-flex align-items-center justify-content-center text-secondary small">
                                    Aucun message échangé pour le moment.
                                </div>
                            {% else %}
                                <div class="d-flex flex-column gap-3">
                                    {% for msg in messages %}
                                        {% set isSent = msg.sender.id == member.id %}
                                        <div class="d-flex flex-column {{ isSent ? 'align-items-end' : 'align-items-start' }}">
                                            <div class="small text-secondary mb-1">
                                                {% if isSent %}
                                                    À : {{ msg.recipient.displayNumber }} · {{ msg.createdAt|date('H:i') }}
                                                {% else %}
                                                    De : {{ msg.sender.displayNumber }} · {{ msg.createdAt|date('H:i') }}
                                                {% endif %}
                                            </div>
                                            <div class="p-3 rounded-3 max-w-75 shadow-sm {{ isSent ? 'text-white' : 'bg-secondary text-white' }}" 
                                                 style="{{ isSent ? 'background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);' : 'background-color: #3f3f46;' }} max-width: 80%;">
                                                {{ msg.body }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Send Message Form -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-lg bg-dark text-white rounded-4 p-4">
                        <h3 class="h5 fw-bold mb-3 border-bottom border-secondary pb-2">Nouveau message</h3>
                        
                        <form action="{{ path('app_messages') }}" method="post">
                            {% if error %}
                                <div class="alert alert-danger border-0 rounded-3 small p-2 mb-3">{{ error }}</div>
                            {% endif %}
                            {% if success %}
                                <div class="alert alert-success border-0 rounded-3 small p-2 mb-3">{{ success }}</div>
                            {% endif %}

                            <div class="mb-3">
                                <label class="form-label small" for="recipient_id">Destinataire</label>
                                <select id="recipient_id" name="recipient_id" class="form-select bg-secondary text-white border-0 py-2 rounded-3" required>
                                    <option value="" disabled selected>Choisir un membre...</option>
                                    {% for rec in recipients %}
                                        <option value="{{ rec.id }}">{{ rec.displayNumber }} ({{ rec.emailAddress }})</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small" for="body">Message</label>
                                <textarea id="body" name="body" rows="6" class="form-control bg-secondary text-white border-0 py-2 rounded-3" placeholder="Tapez votre message secret..." required></textarea>
                            </div>

                            <button type="submit" class="btn w-100 py-2.5 text-white fw-bold rounded-3 border-0" style="background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);">
                                Envoyer le message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

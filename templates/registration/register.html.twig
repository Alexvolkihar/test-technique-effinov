{% extends 'base.html.twig' %}

{% block title %}Inscription - Fight Club{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 p-3 d-flex align-items-center bg-success text-white">
                        <span class="fs-4 me-2">✓</span>
                        <div>{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            {{ component('RegistrationForm', { form: form }) }}
        </div>
    </div>
</div>
{% endblock %}
